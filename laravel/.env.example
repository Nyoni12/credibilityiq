APP_NAME="CredibilityIQ"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://credibilityiq.piquesquid.net

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=credibilityiq
DB_USERNAME=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@piquesquid.net"
MAIL_FROM_NAME="${APP_NAME}"

SUPERADMIN_EMAIL=admin@credibilityiq.com
SUPERADMIN_PASSWORD=ChangeThisNow!2025
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin
